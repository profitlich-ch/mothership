{
  "manifestVersion": 5,
  "id": "ch.profitlich.ai-pirate",
  "name": "AI Pirate",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "21.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pirate",
      "label": {
        "default": "AI Pirate"
      },
      "minimumSize": { "width": 240, "height": 320 },
      "maximumSize": { "width": 4000, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 480, "height": 640 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/skull-dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/skull-light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://api.anthropic.com"]
    },
    "webview": {
      "allow": "yes",
      "domains": [],
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    },
    "localFileSystem": "plugin",
    "allowCodeGenerationFromStrings": true
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/skull-dark.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"],
      "species": ["pluginList"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/skull-light.svg",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["pluginList"]
    }
  ]
}
